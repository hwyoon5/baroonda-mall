# Pi Developer Portal > 내 앱 > API Key (서버 전용, 절대 클라이언트에 노출 금지)
PI_API_KEY=
# 로그인 세션 토큰 서명 키 (긴 임의 문자열). 비우면 PI_API_KEY로 서명
SESSION_SECRET=
# Pi Developer Portal > 내 앱 > App Wallet의 비밀 시드(S로 시작하는 56자). 판매자 정산·환불(A2U) 송금에 사용. 서버 전용
PI_WALLET_PRIVATE_SEED=
# 판매대금 정산 시 차감할 플랫폼 수수료(%) 0~30, 기본 0
PLATFORM_FEE_PERCENT=0
# Pi Testnet 샌드박스(sandbox.minepi.com)에서 테스트할 때만 true
NEXT_PUBLIC_PI_SANDBOX=false

# 판매글·주문 저장소: Vercel Marketplace의 Upstash Redis 연결 시 자동 설정됨
# 비어 있으면 메모리 저장(서버 재시작/인스턴스마다 초기화 → 개발용)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 로컬 테스트 전용: Pi Browser 없이 로그인/결제 흉내. 배포 환경에서는 절대 켜지 마세요.
# PI_MOCK=1
# NEXT_PUBLIC_PI_MOCK=1
