# Pi Developer Portal > 내 앱 > API Key (서버 전용, 절대 클라이언트에 노출 금지)
PI_API_KEY=
# 로그인 세션 토큰 서명 키 (긴 임의 문자열). 비우면 PI_API_KEY로 서명
SESSION_SECRET=
# Pi Developer Portal > 내 앱 > App Wallet의 비밀 시드(S로 시작하는 56자). 판매자 정산·환불(A2U) 송금에 사용. 서버 전용
PI_WALLET_PRIVATE_SEED=
# 판매대금 정산 시 차감할 플랫폼 수수료(%) 0~30, 기본 0
PLATFORM_FEE_PERCENT=0
# Pi Testnet 샌드박스(sandbox.minepi.com)에서 테스트할 때만 true
NEXT_PUBLIC_PI_SANDBOX=false

# 예시 상품을 맡을 운영자 Pi 사용자 이름(@ 없이, 비워 두면 hwyoon5). 이 계정으로 한 번 로그인하면 예시 상품의 관리·판매 내역·정산이 이 계정으로 연결됨
DEMO_SELLER_USERNAME=

# 판매글·주문 저장소: Vercel Marketplace의 Upstash Redis 연결 시 자동 설정됨
# 비어 있으면 메모리 저장(서버 재시작/인스턴스마다 초기화 → 개발용)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 판매글 사진·동영상 저장소: Vercel Storage의 Blob 연결 시 자동 설정됨
# 비어 있으면 동영상 업로드 비활성, 사진은 판매글에 data URL로 저장
BLOB_READ_WRITE_TOKEN=

# 도배·과부하 방지: 판매자 1명이 하루(한국 시간)에 등록할 수 있는 상품 수(임시저장 포함, 기본 30)와
# 올릴 수 있는 사진·동영상 수(기본 400). 관리자(ADMIN_USERNAMES·운영자)는 제외
MAX_LISTINGS_PER_DAY=
MAX_UPLOADS_PER_DAY=

# 로컬 테스트 전용: Pi Browser 없이 로그인/결제 흉내. 배포 환경에서는 절대 켜지 마세요.
# PI_MOCK=1
# NEXT_PUBLIC_PI_MOCK=1
# 상품 등록·사업자 정보 화면의 '테스트 데이터 자동 채우기' 버튼을 모든 사용자에게 보이기(테스트 서버 전용, 운영에서는 비워 두기).
# 비워 두면 로컬 mock과 관리자 계정에만 보여요.
# NEXT_PUBLIC_DUMMY_FILL=1
